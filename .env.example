# Google Gemini API key (required for AI features)
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id (examples: gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-flash)
AI_MODEL=gemini-2.0-flash

# Persistence. Default is SQLite for local/dev; switch to Postgres
# in production (or via `docker compose up -d` at the repo root).
DATABASE_URL=sqlite:///./accesslearn.db
# DATABASE_URL=postgresql://accesslearn:accesslearn@localhost:5432/accesslearn

UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
OCR_CONFIDENCE_THRESHOLD=0.75
FILE_RETENTION_DAYS=30
